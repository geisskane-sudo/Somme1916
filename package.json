{
  "name": "somme1916",
  "private": true,
  "description": "A watch-only simulation of the British attack on the Somme, 1 July 1916",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-steer",
    "serve": "node scripts/serve.mjs 8090",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
